{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1240px",
      "wideSize": "1400px"
    },
    "color": {
      "palette": [
        { "slug": "canvas", "color": "#0A0B0E", "name": "Obsidian Canvas" },
        { "slug": "surface", "color": "#13161D", "name": "Graphite Surface" },
        { "slug": "elevated", "color": "#1B1F2A", "name": "Elevated Slate" },
        { "slug": "crimson", "color": "#E31837", "name": "Apex Crimson" },
        { "slug": "volt", "color": "#B8FF00", "name": "Athletic Volt" },
        { "slug": "alabaster", "color": "#F8FAFC", "name": "Alabaster White" },
        { "slug": "muted", "color": "#94A3B8", "name": "Muted Slate" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Barlow Condensed', system-ui, sans-serif",
          "slug": "display",
          "name": "Barlow Condensed (Display)"
        },
        {
          "fontFamily": "'Plus Jakarta Sans', system-ui, sans-serif",
          "slug": "body",
          "name": "Plus Jakarta Sans (Body)"
        },
        {
          "fontFamily": "'Lexend', system-ui, sans-serif",
          "slug": "dyslexia",
          "name": "Lexend (Dyslexia Friendly)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#0A0B0E",
      "text": "#F8FAFC"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#E31837"
        }
      }
    }
  }
}
